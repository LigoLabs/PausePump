<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App watchOS single-target autonome (compagne de com.ligolabs.pausepump). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
	<string>PausePump</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PausePump</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Ne JAMAIS figer ces deux valeurs : elles doivent égaler celles de
	     l'app hôte, sinon l'envoi à App Store Connect échoue (ITMS-90473).
	     Les build settings correspondants sont posés par
	     ios/scripts/setup_ios_targets.rb depuis $(FLUTTER_BUILD_*). -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.ligolabs.pausepump</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
